<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".KrouenTesApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="tiramisu"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KrouenTes">

        <!-- 1. Loading screen — the only launcher entry -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.KrouenTes.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Log in / sign up with phone number + SMS code -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 3. Home (bottom nav: Home, Wishlist, Category) + recipe screens -->
        <activity
            android:name=".ui.activities.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.activities.MealActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.MealDetailesActivity"
            android:exported="false" />

        <!-- App lock screen (fingerprint / face / phone PIN) -->
        <activity
            android:name=".security.LockActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- 4. Create recipe (green + button) -->
        <activity
            android:name=".ui.activities.CreateRecipeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
