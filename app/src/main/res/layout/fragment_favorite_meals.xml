<?xml version="1.0" encoding="utf-8"?>
<!-- Wishlist — slide style grid of saved recipes (2 cols phone, 3 tablet, 4 wide) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".ui.activities.MainActivity">

    <TextView
        android:id="@+id/tv_wishlist_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="12dp"
        android:text="@string/wishlist"
        android:textAppearance="@style/Text.ScreenTitle" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fav_rec_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="8dp"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/tv_fav_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawablePadding="12dp"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/wishlist_empty"
            android:textAppearance="@style/Text.Caption"
            android:textSize="@dimen/text_body"
            android:visibility="gone"
            app:drawableTint="@color/brand_green_light"
            app:drawableTopCompat="@drawable/ic_bookmark" />
    </FrameLayout>
</LinearLayout>
