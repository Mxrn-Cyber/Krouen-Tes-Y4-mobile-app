<?xml version="1.0" encoding="utf-8"?>
<!-- One instruction step: number bubble + text; tap to mark done -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_soft_row"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_step_number"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_step_number"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="1" />

    <TextView
        android:id="@+id/tv_step_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:lineSpacingMultiplier="1.25"
        android:textAppearance="@style/Text.Body"
        tools:text="Slice the beef thinly and marinate with oyster sauce." />
</LinearLayout>
