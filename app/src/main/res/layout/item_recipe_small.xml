<?xml version="1.0" encoding="utf-8"?>
<!-- Small "Recent recipe" card (Home) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/card_small_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/img_recent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_small_image"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_image"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.KrouenTes.Rounded" />

    <TextView
        android:id="@+id/tv_recent_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:lines="2"
        android:textAppearance="@style/Text.Body"
        android:textSize="@dimen/text_small"
        android:textStyle="bold"
        tools:text="Indonesian chicken burger" />

    <TextView
        android:id="@+id/tv_recent_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/Text.Caption"
        android:textSize="@dimen/text_tiny"
        tools:text="By Krouen Tes" />
</LinearLayout>
