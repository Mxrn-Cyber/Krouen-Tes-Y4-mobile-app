<?xml version="1.0" encoding="utf-8"?>
<!-- One tab of the bottom bar: outline icon; when selected the + sits above it and its name shows -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/tab_icon"
        android:layout_width="@dimen/nav_icon_size"
        android:layout_height="@dimen/nav_icon_size"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        app:tint="@color/nav_inactive"
        tools:src="@drawable/ic_nav_home" />

    <!-- Shown on the bell tab when there are new notifications -->
    <View
        android:id="@+id/tab_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_dot_unread"
        android:importantForAccessibility="no"
        android:translationX="10dp"
        android:translationY="-10dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tab_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="6dp"
        android:alpha="0"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textAppearance="@style/Text.Link"
        android:textSize="11sp"
        tools:alpha="1"
        tools:text="Home" />
</FrameLayout>
