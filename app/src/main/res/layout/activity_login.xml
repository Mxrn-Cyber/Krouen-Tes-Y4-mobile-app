<?xml version="1.0" encoding="utf-8"?>
<!-- Log in / sign up with a phone number and a 6-digit SMS code (OTP).
     Step 1: phone number → Send code. Step 2: code → Verify. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipChildren="false"
    tools:context=".ui.auth.LoginActivity">

    <!-- Light green blobs in two corners (they turn slowly) -->
    <ImageView
        android:id="@+id/login_blob_top"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="top|end"
        android:alpha="0.35"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_auth_blob"
        android:translationX="90dp"
        android:translationY="-90dp" />

    <ImageView
        android:id="@+id/login_blob_bottom"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="bottom|start"
        android:alpha="0.18"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_auth_blob"
        android:translationX="-80dp"
        android:translationY="80dp" />

    <ScrollView
        android:id="@+id/auth_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">

            <!-- The wok from the splash screen lands here -->
            <ImageView
                android:id="@+id/login_logo"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/logo_wok"
                android:transitionName="brand_logo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/login_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/otp_title"
                android:textAppearance="@style/Text.ScreenTitle"
                android:textSize="30sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/login_logo" />

            <TextView
                android:id="@+id/login_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/otp_subtitle"
                android:textAppearance="@style/Text.Body"
                android:textColor="@color/text_secondary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/login_title" />

            <!-- Form: max 440dp wide on tablets -->
            <LinearLayout
                android:id="@+id/login_form"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:animateLayoutChanges="true"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/login_subtitle"
                app:layout_constraintWidth_max="@dimen/max_form_width">

                <!-- Step 1: phone number -->
                <LinearLayout
                    android:id="@+id/phone_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/login_phone_box"
                        style="@style/Widget.KrouenTes.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/phone_number"
                        app:helperText="@string/phone_helper"
                        app:placeholderText="@string/phone_placeholder"
                        app:startIconDrawable="@drawable/ic_phone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/login_phone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="phoneNumber"
                            android:imeOptions="actionSend"
                            android:inputType="phone"
                            android:maxLength="20" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_send_code"
                        style="@style/Widget.KrouenTes.PrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_marginTop="20dp"
                        android:text="@string/send_code"
                        android:transitionName="auth_button" />
                </LinearLayout>

                <!-- Step 2: the 6-digit code -->
                <LinearLayout
                    android:id="@+id/code_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_code_sent_to"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:textAppearance="@style/Text.Body"
                        app:drawableStartCompat="@drawable/ic_sms"
                        app:drawableTint="@color/brand_green"
                        tools:text="Enter the code we sent to +855 12 345 678" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/login_code_box"
                        style="@style/Widget.KrouenTes.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/code_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/login_code"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="smsOTPCode"
                            android:fontFamily="@font/app_font_semibold"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="yes"
                            android:inputType="number"
                            android:letterSpacing="0.6"
                            android:maxLength="6"
                            android:textSize="24sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_verify"
                        style="@style/Widget.KrouenTes.PrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_marginTop="20dp"
                        android:text="@string/verify" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_change_number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingTop="10dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="10dp"
                            android:text="@string/change_number"
                            android:textAppearance="@style/Text.Link" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/btn_resend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:text="@string/resend_code"
                            android:textAppearance="@style/Text.Link"
                            tools:text="Resend in 42 s" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/login_or_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/divider" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/or_continue"
                        android:textAppearance="@style/Text.Caption" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/divider" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/login_social_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/login_google"
                        style="@style/Widget.KrouenTes.SocialButton"
                        android:layout_width="0dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="@string/google" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/login_facebook"
                        style="@style/Widget.KrouenTes.SocialButton"
                        android:layout_width="0dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/facebook" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/login_sms_note"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="@string/otp_note"
                android:textAppearance="@style/Text.Caption"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/login_form"
                app:layout_constraintVertical_bias="1" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</FrameLayout>
