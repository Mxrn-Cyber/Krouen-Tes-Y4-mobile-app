<?xml version="1.0" encoding="utf-8"?>
<!-- Notifications (bell in the bottom bar) — empty state until push messages are added -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".ui.activities.MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/screen_padding"
        android:text="@string/notifications"
        android:textAppearance="@style/Text.ScreenTitle" />

    <TextView
        android:id="@+id/tv_notifications_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:drawablePadding="14dp"
        android:gravity="center"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingBottom="60dp"
        android:text="@string/notifications_empty"
        android:textAppearance="@style/Text.Caption"
        android:textSize="@dimen/text_body"
        app:drawableTint="@color/brand_green_light"
        app:drawableTopCompat="@drawable/ic_nav_bell" />
</LinearLayout>
