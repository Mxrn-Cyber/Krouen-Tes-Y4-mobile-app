<?xml version="1.0" encoding="utf-8"?>
<!-- Only encrypted (HTTPS) connections; trust only the phone's built-in certificates -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
