<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.KrouenTes" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorPrimaryVariant">@color/brand_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_green_light</item>
        <item name="colorSecondaryVariant">@color/brand_green_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Splash: full green screen with the logo, no bars -->
    <style name="Theme.KrouenTes.Splash">
        <item name="android:windowBackground">@color/brand_splash</item>
        <item name="android:statusBarColor">@color/brand_splash</item>
        <item name="android:navigationBarColor">@color/brand_splash</item>
    </style>

    <style name="CustomToolbarTheme" parent="@style/ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">@color/white</item>
        <item name="colorControlNormal">@color/white</item>
    </style>

    <style name="AppBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppModalStyle</item>
    </style>

    <style name="AppModalStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bottom_sheet_dialog_shape</item>
    </style>

    <!-- ===== Krouen Tes UI styles (from the slide mockups) ===== -->
    <style name="Text.ScreenTitle" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.Section" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="Text.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Text.Link" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/brand_green</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- "See all ->" link next to a section title -->
    <style name="Widget.KrouenTes.SeeAll" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:text">@string/see_all</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/brand_green</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="icon">@drawable/ic_arrow_forward</item>
        <item name="iconGravity">end</item>
        <item name="iconSize">14dp</item>
        <item name="iconTint">@color/brand_green</item>
        <item name="iconPadding">4dp</item>
    </style>

    <!-- Big green rounded button (Log in, Sign up) -->
    <style name="Widget.KrouenTes.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/brand_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- White outlined button (Continue with Google / Facebook) -->
    <style name="Widget.KrouenTes.SocialButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">50dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/divider</item>
        <item name="cornerRadius">12dp</item>
        <item name="iconTint">@color/brand_green</item>
    </style>

    <!-- Rounded white text fields -->
    <style name="Widget.KrouenTes.TextField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_input</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/brand_green</item>
        <item name="hintTextColor">@color/brand_green</item>
    </style>

    <!-- Rounded top corners for recipe images -->
    <style name="ShapeAppearance.KrouenTes.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_card</item>
    </style>
    <style name="ShapeAppearance.KrouenTes.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <!-- Category chips on Home (green when selected) -->
    <style name="Widget.KrouenTes.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">38dp</item>
        <item name="android:textSize">@dimen/text_small</item>
    </style>
    <!-- Hides the big title inside the photo; it only shows once the header collapses -->
    <style name="Text.Collapsed.Hidden" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@android:color/transparent</item>
    </style>
    <style name="Text.Tab" parent="TextAppearance.Design.Tab">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
