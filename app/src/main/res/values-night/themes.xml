<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Night mode keeps the same light layouts for now (layouts use fixed light colors). -->
    <style name="Theme.KrouenTes" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorPrimaryVariant">@color/brand_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_green_light</item>
        <item name="colorSecondaryVariant">@color/brand_green_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
        <item name="textAppearanceBody1">@style/TextAppearance.KrouenTes.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.KrouenTes.Body2</item>
        <item name="textAppearanceCaption">@style/TextAppearance.KrouenTes.Caption</item>
        <item name="textAppearanceButton">@style/TextAppearance.KrouenTes.Button</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.KrouenTes.Subtitle1</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.KrouenTes.Subtitle2</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.KrouenTes.Headline6</item>
        <!-- Lets a recipe photo fly from its card into the Recipe page -->
        <item name="android:windowActivityTransitions">true</item>
        <!-- White system navigation bar (gesture line) so it blends with the white bottom bar -->
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>
