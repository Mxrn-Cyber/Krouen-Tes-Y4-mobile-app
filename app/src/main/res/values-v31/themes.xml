<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash shows plain brand green (no icon), so it blends into our animated splash -->
    <style name="Theme.KrouenTes.Splash">
        <item name="android:windowBackground">@drawable/bg_splash_gradient</item>
        <item name="android:statusBarColor">@color/brand_splash</item>
        <item name="android:navigationBarColor">@color/brand_splash</item>
        <item name="android:windowSplashScreenBackground">@color/brand_splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>
